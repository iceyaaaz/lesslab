DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=lesslab_app
DB_PASSWORD=replace_with_your_password
DB_NAME=lesslab
# 本地 MySQL 留空。Render 连接 Aiven 时填写 /etc/secrets/aiven-ca.pem。
DB_SSL_CA=

# 必须与浏览器地址一致，不带末尾斜线。公网部署必须使用 HTTPS。
# Render 上不填写 APP_ORIGIN 时，会自动使用平台提供的 RENDER_EXTERNAL_URL。
APP_ORIGIN=http://127.0.0.1:8000
AUTH_COOKIE_SECURE=false
# 默认关闭注册；完成本机 setup_owner.py 后才能开放。
AUTH_ALLOW_REGISTRATION=false

DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-flash
